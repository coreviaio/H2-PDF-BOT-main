    "articleGeneralData": {
        "outcome": {
            "name": "Hydrogen gas (H2) demonstrates potential as an ergogenic and therapeutic molecule for sports athletes by selectively reducing excessive oxidative stress and inflammation without impairing beneficial exercise adaptations. H2 may act as an exercise mimetic and redox adaptogen, supporting mitochondrial function, antioxidant status, and recovery, with a high safety profile. More research is needed to confirm its efficacy and optimal administration in exercise medicine.",
            "status": "unverified"
        },
        "outcomeType": [
            "positive"
        ],
        "rankThisArticle": {
            "name": 90,
            "status": "unverified"
        },
        "HighlightArticle": {
            "name": true,
            "status": "unverified"
        },
        "descHighArt": {
            "name": "This review highlights the unique potential of molecular hydrogen as both an ergogenic aid and a redox adaptogen in sports medicine, emphasizing its ability to reduce harmful effects of excessive exercise-induced oxidative stress and inflammation while preserving or enhancing beneficial adaptations. The article synthesizes evidence from both animal and human studies, and proposes hydrogen as a promising, safe, and novel intervention for athletes.",
            "status": "unverified"
        },
