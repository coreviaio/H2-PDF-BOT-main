    "articleGeneralData": {
        "outcome": {
            "name": "Molecular hydrogen, administered as either inhaled gas (1% H2 in air) or as hydrogen-rich water (0.8 mM), significantly alleviated cisplatin-induced nephrotoxicity in mice, as evidenced by improved survival, reduced body-weight loss, lower serum creatinine and BUN, reduced oxidative stress (MDA), and less histopathological kidney damage. Importantly, hydrogen did not compromise the anti-tumor activity of cisplatin in vitro or in vivo.",
            "status": "unverified"
        },
        "outcomeType": [
            "positive"
        ],
