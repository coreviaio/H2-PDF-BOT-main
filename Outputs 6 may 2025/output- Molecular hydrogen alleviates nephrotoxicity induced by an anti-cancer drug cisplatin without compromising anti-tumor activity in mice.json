    "publicData": {
        "title": {
            "name": "Molecular hydrogen alleviates nephrotoxicity induced by an anti-cancer drug cisplatin without compromising anti-tumor activity in mice",
            "status": "unverified"
        },
        "name": "19148645",
        "doi": {
            "name": "10.1007/s00280-008-0924-2",
            "status": "unverified"
